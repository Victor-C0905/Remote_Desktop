{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Quireld",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package",
                    "quireld",
                    "--bin",
                    "quireld"
                ],
                "filter": {
                    "name": "quireld",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}/agent",
            "stopOnEntry": false,
            "showDisassembly": "never",
            "evaluateForHovers": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "reuseWindows": "prompt"
        },
        {
            "name": "Debug Quireld",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package",
                    "quireld",
                    "--bin",
                    "quireld",
                    "--features",
                    "debug"
                ],
                "filter": {
                    "name": "quireld",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}/agent",
            "stopOnEntry": false,
            "showDisassembly": "never",
            "evaluateForHovers": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "reuseWindows": "prompt"
        },
        {
            "name": "Run Tauri App (Development)",
            "type": "shell",
            "request": "launch",
            "command": "npm run tauri dev",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$rustc",
            "reuseWindows": "prompt"
        }
    ],
    "compounds": [
        {
            "name": "Full Debug (Quireld + Tauri)",
            "configurations": [
                "Run Quireld"
            ],
            "stopAll": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}