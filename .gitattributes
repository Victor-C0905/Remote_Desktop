# Git 换行符配置
# 自动检测文本文件并规范化换行符
* text=auto

# 源代码文件 - 强制使用 LF（跨平台协作）
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

# 配置文件 - 强制使用 LF
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.config text eol=lf

# Windows 批处理文件 - 使用 CRLF（Windows 特定）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件 - 不处理换行符
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pem binary
*.key binary
*.crt binary

# Git 自身文件
.gitattributes text
.gitignore text
.gitmodules text